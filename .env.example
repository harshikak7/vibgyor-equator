# Public business WhatsApp number, international format, digits only (e.g. 91XXXXXXXXXX).
# Note: VITE_* values are bundled into the browser; this is configuration, not a secret.
VITE_WHATSAPP_NUMBER=

# Deploy a Google Apps Script web app and paste its /exec URL here.
# This URL is also visible to visitors because it is used by the frontend.
VITE_GOOGLE_SCRIPT_URL=

# Public Sanity project configuration (not secrets).
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SANITY_API_VERSION=2025-01-01
